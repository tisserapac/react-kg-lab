# Copy this file to .env and fill in ONE of the two keys.
# .env is git-ignored: never commit your key.

# Which LLM to call: anthropic or openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the model (defaults: claude-sonnet-5-5 / gpt-5.5)
# Other options: claude-sonnet-5, claude-opus-5-5 (Anthropic); gpt-5.4-mini (OpenAI, smaller and cheaper)
# LLM_MODEL=

# Where the movie-watchlist repo is (default: ../movie-watchlist)
# APP_DIR=../movie-watchlist

# Memgraph (default: bolt://localhost:7687, no user or password)
# MEMGRAPH_URI=bolt://localhost:7687
